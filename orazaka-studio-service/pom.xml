<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.krizaka.orazaka</groupId>
        <artifactId>orazaka-studio</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orazaka-studio-service</artifactId>
    <name>orazaka-studio-service</name>
    <description>Studio service — the marketplace of installable business workflows: catalogue, blueprint versions, installations and run sagas over its own database (ADR-034)</description>

    <dependencies>
        <!-- Krizaka platform kit: idempotent message consumption (claim / release). -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-messaging</artifactId>
        </dependency>
        <!-- Krizaka platform kit: session-JWT security baseline and service-to-service tokens. -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-security</artifactId>
        </dependency>
        <!-- The Tier-1 contract this service serves (models + ports, zero impl deps) -->
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-studio-api</artifactId>
        </dependency>

        <!-- Tier-1 job-plane contract: a step is dispatched to the routing key its capability row
             carries, resolved through CapabilityRoutingClient — never derived from the key
             (ADR-037 S1). Contract only; the job service owns the table. -->
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-jobs-api</artifactId>
        </dependency>

        <!-- Tier-1 billing contract: one hold per run, entitlement gates access (ADR-033).
             The IMPLEMENTATION (krizaka-billing-service) is another context's Tier-3 and is
             never imported — SEAM-002. -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-billing-api</artifactId>
        </dependency>

        <!-- Tier-2 SDK: the producer side of that contract. Selects a NoOp or an HTTP adapter at
             bootstrap, so no call site here ever branches on whether billing exists (ERR-127). -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-billing-client</artifactId>
        </dependency>

        <!-- NOTE (deviation from design §3/§9.2, deliberate): this service does NOT depend on
             orazaka-business. SEAM-002 lists com.orazaka.business.. as a foreign Tier-3 impl, and
             design §15 itself requires StudioServiceGovernanceTest to enforce SEAM-002 — the two
             cannot both hold. AGENTS.md wins: the DAG interpreter lives in this service's own
             application/service, and the Intention path reaches it through the Tier-1
             StudioRunClient port implemented by an HTTP SDK, exactly as krizaka-billing-client
             does for CreditAuthorizationClient. Hosting business here would give that library a
             second owner, which is the distributed monolith AGENTS.md §2 names as the health gauge. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Outbound HTTP to the job plane's capability registry (AGENTS.md §4: RestClient). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Security: authoring is @PreAuthorize-gated, every read is scoped by actor. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Distributed tracing: Micrometer Tracing over the OpenTelemetry bridge, OTLP/HTTP. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- AMQP: the saga publishes JobCommands and consumes job.*.done|error.
             The exchanges ARE the API — this service never calls the job service over HTTP. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- JDBC over the service's OWN database. Deliberately NOT spring-boot-starter-data-jpa:
             AGENTS.md §5 forbids JPA entities outside orazaka-persistence, and the saga advances a
             step with a single conditional UPDATE that must not go through dirty checking. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON: blueprint definitions, JSON Schema validation, outbox payloads (JSONB) -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-test-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
