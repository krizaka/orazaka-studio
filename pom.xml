<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The relativePath resolves inside the Sovkora workspace (krizaka/sovkora); a standalone
         clone falls back to the sovkora-parent published on GitHub Packages. -->
    <parent>
        <groupId>com.krizaka.sovkora</groupId>
        <artifactId>sovkora-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../sovkora-libs/sovkora-build/sovkora-parent/pom.xml</relativePath>
    </parent>

    <artifactId>sovkora-studio</artifactId>
    <packaging>pom</packaging>
    <name>sovkora-studio-service</name>
    <description>Studio &amp; pack marketplace: pack catalogue, studio blueprints, installations and saga-driven runs, with its contract (studio-api) and HTTP client (studio-client).</description>

    <url>https://github.com/krizaka/sovkora-studio-service</url>

    <scm>
        <url>https://github.com/krizaka/sovkora-studio-service</url>
        <connection>scm:git:https://github.com/krizaka/sovkora-studio-service.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/sovkora-studio-service.git</developerConnection>
    </scm>
    <licenses>
        <license>
            <name>FSL-1.1-ALv2</name>
            <url>https://fsl.software/FSL-1.1-ALv2.template.md</url>
            <distribution>repo</distribution>
            <comments>Functional Source License 1.1, Apache-2.0 future licence (ADR-011). Earlier commits: Apache-2.0.</comments>
        </license>
    </licenses>


    <properties>
        <!-- GitHub Packages repository the modules below are published to (sovkora-parent). -->
        <sovkora.repository>sovkora-studio-service</sovkora.repository>
    </properties>

    <modules>
        <module>sovkora-studio-api</module>
        <module>sovkora-studio-client</module>
        <module>sovkora-studio-service</module>
    </modules>
</project>
